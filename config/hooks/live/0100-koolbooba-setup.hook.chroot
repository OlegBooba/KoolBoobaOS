#!/bin/sh
# ============================================================
# Хук выполняется внутри chroot во время сборки live-build
# Финальная настройка KoolBoobaOS
# ============================================================
set -e

echo "[hook] Настраиваю локаль и раскладку..."
sed -i 's/^# *ru_RU.UTF-8/ru_RU.UTF-8/' /etc/locale.gen || true
sed -i 's/^# *en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen || true
locale-gen || true
update-locale LANG=ru_RU.UTF-8 || true

echo "[hook] Включаю LightDM как менеджер входа по умолчанию..."
echo "/usr/sbin/lightdm" > /etc/X11/default-display-manager
systemctl set-default graphical.target || true
systemctl enable lightdm || true

echo "[hook] Делаю ярлыки на рабочем столе исполняемыми по умолчанию..."
chmod +x /usr/local/bin/koolbooba-install.sh || true
find /etc/skel/Desktop -name "*.desktop" -exec chmod +x {} \; || true

echo "[hook] Прописываю доверие ярлыкам XFCE (чтобы не спрашивало confirm при первом клике)..."
mkdir -p /etc/xdg/xfce4
cat > /etc/xdg/xfce4/xfconf-trust.conf << 'EOF'
# служебный файл KoolBoobaOS
EOF

echo "[hook] Устанавливаю имя системы (os-release) под KoolBoobaOS..."
cat > /etc/os-release << 'EOF'
PRETTY_NAME="KoolBoobaOS 1.0"
NAME="KoolBoobaOS"
VERSION_ID="1.0"
VERSION="1.0 (bookworm)"
VERSION_CODENAME=bookworm
ID=koolbooba
ID_LIKE=debian
HOME_URL="https://github.com/"
SUPPORT_URL="https://github.com/"
BUG_REPORT_URL="https://github.com/"
EOF

cat > /etc/issue << 'EOF'
KoolBoobaOS 1.0 \n \l

EOF

echo "KoolBoobaOS" > /etc/hostname

echo "[hook] Обновляю кэш иконок и схем GTK..."
gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
update-desktop-database /usr/share/applications 2>/dev/null || true

echo "[hook] Устанавливаю Win7-KoolBooba как тему по умолчанию через автозапуск первого входа..."
mkdir -p /etc/skel/.config/autostart

cat > /etc/skel/.config/autostart/koolbooba-firstrun.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=KoolBoobaOS First Run
Exec=/usr/local/bin/koolbooba-firstrun.sh
X-GNOME-Autostart-enabled=true
NoDisplay=true
EOF

cat > /usr/local/bin/koolbooba-firstrun.sh << 'SCRIPT'
#!/bin/bash
# Применяет тему Win7-KoolBooba при первом входе пользователя,
# если настройки ещё не были скопированы из /etc/skel
xfconf-query -c xsettings -p /Net/ThemeName -s "Win7-KoolBooba" 2>/dev/null || true
xfconf-query -c xsettings -p /Net/IconThemeName -s "Win7-KoolBooba-Icons" 2>/dev/null || true
xfconf-query -c xfwm4 -p /general/theme -s "Win7-KoolBooba" 2>/dev/null || true
# запускаем только один раз
rm -f "$HOME/.config/autostart/koolbooba-firstrun.desktop"
SCRIPT
chmod +x /usr/local/bin/koolbooba-firstrun.sh

echo "[hook] Готово."
